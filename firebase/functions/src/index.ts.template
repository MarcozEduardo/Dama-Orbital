import { initializeApp } from "firebase-admin/app";
import { getDatabase } from "firebase-admin/database";
import { onCall, HttpsError } from "firebase-functions/v2/https";
import { onSchedule } from "firebase-functions/v2/scheduler";
import { defineSecret } from "firebase-functions/params";

// Gerar/copy this adapter na próxima sessão a partir de src/game/engine.ts.
import { applyIntentOnServer, initialBoardString } from "./shared/engine-adapter";

initializeApp();
const db = getDatabase();
const TURN_API_TOKEN = defineSecret("CLOUDFLARE_TURN_API_TOKEN");
const TURN_KEY_ID = defineSecret("CLOUDFLARE_TURN_KEY_ID");

const ALPHABET = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
const TURN_MS = 30_000;

const requireUid = (uid?: string) => {
  if (!uid) throw new HttpsError("unauthenticated", "Anonymous Auth é obrigatório.");
  return uid;
};

const cleanNick = (value: unknown) =>
  String(value || "COMANDANTE")
    .replace(/[<>\n\r]/g, "")
    .trim()
    .slice(0, 14);

const randomCode = () =>
  Array.from({ length: 6 }, () => ALPHABET[Math.floor(Math.random() * ALPHABET.length)]).join("");

/** 1. Cria partida, reserva chave global e entrega cadeira P1. */
export const createMatch = onCall(async (request) => {
  const uid = requireUid(request.auth?.uid);
  const matchId = db.ref("matches").push().key!;
  let code = "";

  for (let attempt = 0; attempt < 64; attempt++) {
    const candidate = randomCode();
    const keyRef = db.ref(`keys/${candidate}`);
    const tx = await keyRef.transaction((current) =>
      current === null
        ? {
            matchId,
            ownerUid: uid,
            createdAt: Date.now(),
            expiresAt: Date.now() + 2 * 60 * 60 * 1000,
            status: "waiting",
          }
        : undefined,
    );
    if (tx.committed) {
      code = candidate;
      break;
    }
  }
  if (!code) throw new HttpsError("resource-exhausted", "Não foi possível reservar uma chave.");

  const now = Date.now();
  const board = initialBoardString();
  await db.ref(`matches/${matchId}`).set({
    version: 1,
    code,
    status: "waiting",
    createdAt: now,
    expiresAt: now + 15 * 60 * 1000,
    updatedAt: now,
    players: { p1: { uid, nick: cleanNick(request.data?.nick), joinedAt: now, lastSeen: now } },
    state: {
      board,
      turn: 1,
      seq: 0,
      deadlineAt: 0,
      stateHash: request.data?.stateHash || "",
    },
  });
  return { matchId, code, seat: "host" };
});

/** 2. Injeta chave: cadeira P2 se livre; caso contrário, observador. */
export const joinMatch = onCall(async (request) => {
  const uid = requireUid(request.auth?.uid);
  const code = String(request.data?.code || "").toUpperCase().slice(0, 6);
  const key = (await db.ref(`keys/${code}`).get()).val();
  if (!key?.matchId) throw new HttpsError("not-found", "Chave inválida ou expirada.");

  const matchRef = db.ref(`matches/${key.matchId}`);
  const match = (await matchRef.get()).val();
  if (!match || match.status === "finished" || match.expiresAt < Date.now()) {
    throw new HttpsError("failed-precondition", "Partida finalizada ou expirada.");
  }
  if (match.players?.p1?.uid === uid) return { matchId: key.matchId, code, seat: "host" };

  const p2Ref = matchRef.child("players/p2");
  const claim = await p2Ref.transaction((current) =>
    current === null || current?.uid === uid
      ? current || { uid, nick: cleanNick(request.data?.nick), joinedAt: Date.now(), lastSeen: Date.now() }
      : undefined,
  );
  if (claim.committed && claim.snapshot.val()?.uid === uid) {
    await matchRef.update({
      status: "playing",
      expiresAt: Date.now() + 2 * 60 * 60 * 1000,
      updatedAt: Date.now(),
      "state/deadlineAt": Date.now() + TURN_MS,
    });
    return { matchId: key.matchId, code, seat: "guest" };
  }

  await matchRef.child(`observers/${uid}`).set({
    uid,
    nick: cleanNick(request.data?.nick || "OBSERVADOR"),
    joinedAt: Date.now(),
    lastSeen: Date.now(),
  });
  return { matchId: key.matchId, code, seat: "observer" };
});

/** 3. Autoridade real: valida a intenção com a MESMA engine do browser. */
export const submitMatchEvent = onCall(async (request) => {
  const uid = requireUid(request.auth?.uid);
  const event = request.data?.event;
  if (!event?.matchId || !event?.eventId) throw new HttpsError("invalid-argument", "Evento inválido.");

  const matchRef = db.ref(`matches/${event.matchId}`);
  let rejection = "";
  const tx = await matchRef.transaction((match) => {
    if (!match || match.status !== "playing") {
      rejection = "MATCH_CLOSED";
      return;
    }
    const seat = match.players?.p1?.uid === uid ? 1 : match.players?.p2?.uid === uid ? 2 : 0;
    if (!seat) {
      rejection = "NOT_PLAYER";
      return;
    }
    if (match.state.turn !== seat || match.state.seq !== event.seqExpected) {
      rejection = "STALE_OR_WRONG_TURN";
      return;
    }

    const commit = applyIntentOnServer(match.state, event);
    match.state = commit;
    match.updatedAt = Date.now();
    if (commit.winner) match.status = "finished";
    return match;
  });
  if (!tx.committed) throw new HttpsError("aborted", rejection || "EVENT_REJECTED");
  return { commit: tx.snapshot.val().state };
});

/** 4. Rádio: filtro/rate limit precisam existir também no servidor. */
export const sendRadio = onCall(async (request) => {
  const uid = requireUid(request.auth?.uid);
  const matchId = String(request.data?.matchId || "");
  const text = String(request.data?.text || "").trim().slice(0, 40);
  if (text.length < 2) throw new HttpsError("invalid-argument", "Mensagem inválida.");
  // TODO: copiar exatamente filterMessage de src/components/RadioBox.tsx para shared/radio.ts.

  const match = (await db.ref(`matches/${matchId}`).get()).val();
  if (match?.players?.p1?.uid !== uid && match?.players?.p2?.uid !== uid) {
    throw new HttpsError("permission-denied", "Observadores não usam o rádio.");
  }
  const lastRef = db.ref(`radioRate/${matchId}/${uid}`);
  const last = Number((await lastRef.get()).val()) || 0;
  if (Date.now() - last < 5_000) throw new HttpsError("resource-exhausted", "Rádio recarregando.");
  await lastRef.set(Date.now());
  await db.ref(`matches/${matchId}/radio`).push({ uid, text, createdAt: Date.now() });
  return { ok: true };
});

/** 5. Credenciais TURN efêmeras; os segredos nunca chegam ao bundle. */
export const getTurnCredentials = onCall(
  { secrets: [TURN_API_TOKEN, TURN_KEY_ID] },
  async (request) => {
    requireUid(request.auth?.uid);
    const response = await fetch(
      `https://rtc.live.cloudflare.com/v1/turn/keys/${TURN_KEY_ID.value()}/credentials/generate-ice-servers`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${TURN_API_TOKEN.value()}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ ttl: 3600 }),
      },
    );
    if (!response.ok) throw new HttpsError("unavailable", `TURN respondeu ${response.status}`);
    return await response.json();
  },
);

/** 6. Limpeza opcional. Mantém a chave como tombstone; remove payload pesado. */
export const expireMatches = onSchedule("every 15 minutes", async () => {
  const snapshot = await db.ref("matches").orderByChild("expiresAt").endAt(Date.now()).get();
  const updates: Record<string, unknown> = {};
  snapshot.forEach((child) => {
    const match = child.val();
    if (match?.status !== "finished") updates[`matches/${child.key}/status`] = "expired";
    updates[`keys/${match.code}/status`] = "expired";
    updates[`matches/${child.key}/events`] = null;
    updates[`matches/${child.key}/radio`] = null;
  });
  if (Object.keys(updates).length) await db.ref().update(updates);
});